    "experimental_patch": "diff --git a/crates/anagram-core/src/ranking.rs b/crates/anagram-core/src/ranking.rs\nindex 969ca69..54efd21 100644\n--- a/crates/anagram-core/src/ranking.rs\n+++ b/crates/anagram-core/src/ranking.rs\n@@ -185,8 +185,9 @@ pub fn prepare_controlled(\n     Ok(rows)\n }\n \n-/// `per_group` is the initial shortlist size, not a hard deployment work cap:\n-/// family expansion intentionally includes every selected inflection sibling.\n+/// `per_group` counts distinct word families, not inflection siblings competing\n+/// for the same seed slots. Expansion includes every selected sibling; this is\n+/// not a hard deployment work cap (that remains an adapter-owned limit).\n pub fn choose_deep(rows: &[Row], per_group: usize, deep_all: bool) -> BTreeSet<usize> {\n     choose_deep_controlled(\n         rows,\n@@ -218,11 +219,13 @@ pub fn choose_deep_controlled(\n                 .then_with(|| rows[j].input.fam.total_cmp(&rows[i].input.fam))\n                 .then_with(|| rows[j].input.lex.total_cmp(&rows[i].input.lex))\n         })?;\n-        for &i in bucket\n-            .iter()\n-            .take(if deep_all { bucket.len() } else { per_group })\n-        {\n+        let mut seeded = BTreeSet::new();\n+        for &i in bucket.iter() {\n             control.check()?;\n+            if !deep_all && seeded.len() >= per_group {\n+                break;\n+            }\n+            seeded.insert(rows[i].family_key.clone());\n             families.insert((rows[i].input.word_count, rows[i].family_key.clone()));\n         }\n     }\n@@ -515,3 +518,32 @@ pub fn rank_buckets_controlled(\n     }\n     Ok(buckets)\n }\n+\n+#[cfg(test)]\n+mod tests {\n+    use super::*;\n+    fn row(family: &str, score: f64, count: usize) -> Row {\n+        serde_json::from_value(serde_json::json!({\n+            \"words\":[family],\"word_count\":count,\"old_rank\":1,\"old_pre\":0.,\"lex\":0.,\"fam\":0.,\"old_pair\":0.,\"hint\":0.,\"zavg\":0.,\"zmin\":0.,\"old_pcov\":0.,\"hints\":[],\n+            \"wn_coverage\":0.,\"grammar_potential\":0.,\"grammar_potential_norm\":0.,\"pre_score\":score,\"deep\":false,\"best_order\":[],\"grammar_raw\":0.,\"grammar_norm\":0.,\"structure_norm\":0.,\"valency_norm\":0.,\"syntax_coverage\":0.,\"phrase_kind\":\"unknown\",\"base_final\":0.,\"colloc_norm\":0.,\"phrase_attest_norm\":0.,\"phrase_bonus\":0.,\"final\":0.,\"family_key\":[family]\n+        })).unwrap()\n+    }\n+    #[test]\n+    fn inflection_siblings_do_not_consume_distinct_family_seed_slots() {\n+        let rows = vec![\n+            row(\"alpha\", 10., 2),\n+            row(\"alpha\", 9., 2),\n+            row(\"beta\", 8., 2),\n+            row(\"gamma\", 7., 2),\n+            row(\"alpha\", 1., 2),\n+            row(\"delta\", 10., 3),\n+        ];\n+        assert_eq!(\n+            choose_deep(&rows, 2, false),\n+            BTreeSet::from([0, 1, 2, 4, 5])\n+        );\n+        assert_eq!(choose_deep(&rows, 1, false), BTreeSet::from([0, 1, 4, 5]));\n+        assert_eq!(choose_deep(&rows, 0, false), BTreeSet::new());\n+        assert_eq!(choose_deep(&rows, 0, true), (0..rows.len()).collect());\n+    }\n+}\n",
